  ACTIVO
  VENCIDO
  CANCELADO
  RENOVADO
}

enum CondicionesPago {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum ModalidadContrato {
  VENTA
  RENTA
  COMODATO
  MANTENIMIENTO
}

enum EstatusContratoEquipo {
  PENDIENTE
  INSTALADO
  RETIRADO
}

