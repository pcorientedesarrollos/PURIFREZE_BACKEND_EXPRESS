  Codigo                      String?                                 @db.VarChar(50)
  compras_detalle             compras_detalle[]
  cotizaciones_compra_detalle cotizaciones_compra_detalle[]
  cotizaciones_compra_equipos cotizaciones_compra_equipos_virtuales[]
  detalles                    equipos_virtuales_detalle[]
  historial                   equipos_virtuales_historial[]
  presupuestos_detalle        presupuestos_detalle[]

  @@index([Nombre], map: "idx_equipo_virtual_nombre")
  @@index([IsActive], map: "idx_equipo_virtual_activo")
}

model equipos_virtuales_detalle {
  DetalleID               Int                  @id @default(autoincrement())
  EquipoVirtualID         Int
  RefaccionID             Int
  Cantidad                Int?                 @default(1)
  CostoUnitario           Decimal?             @default(0.00) @db.Decimal(12, 2)
  Descuento               Decimal?             @default(0.00) @db.Decimal(5, 2)
  TotalUnitario           Decimal?             @default(0.00) @db.Decimal(12, 2)
  Otros                   Decimal?             @default(0.00) @db.Decimal(12, 2)
  TotalOtros              Decimal?             @default(0.00) @db.Decimal(12, 2)
  CostoImportacion        Decimal?             @default(0.00) @db.Decimal(12, 2)
  TotalUnidad             Decimal?             @default(0.00) @db.Decimal(12, 2)
  TotalFinal              Decimal?             @default(0.00) @db.Decimal(12, 2)
  IVA                     Decimal?             @default(0.00) @db.Decimal(5, 2)
  CantidadPiezasPorEquipo Int?                 @default(1)
  NumeroEquipos           Int?                 @default(1)
  CostoAnterior           Decimal?             @default(0.00) @db.Decimal(12, 2)
  CostoActual             Decimal?             @default(0.00) @db.Decimal(12, 2)
  Diferencia              Decimal?             @default(0.00) @db.Decimal(12, 2)
  IsActive                Boolean?             @default(true)
  equipoVirtual           equipos_virtuales    @relation(fields: [EquipoVirtualID], references: [EquipoVirtualID], onDelete: Cascade, map: "fk_detalle_equipo_virtual")
  refaccion               catalogo_refacciones @relation(fields: [RefaccionID], references: [RefaccionID], map: "fk_detalle_refaccion")

  @@index([EquipoVirtualID], map: "idx_detalle_equipo")
  @@index([RefaccionID], map: "idx_detalle_refaccion")
}

model equipos_virtuales_historial {
  HistorialID        Int                             @id @default(autoincrement())
  EquipoVirtualID    Int
  FechaCambio        DateTime?                       @default(now()) @db.DateTime(0)
  PrecioAnterior     Decimal                         @db.Decimal(12, 2)
  PrecioNuevo        Decimal                         @db.Decimal(12, 2)
  Diferencia         Decimal                         @db.Decimal(12, 2)
  DetallesCambio     Json?
  UsuarioID          Int?
  Observaciones      String?                         @db.VarChar(500)
  CotizacionCompraID Int?
  equipoVirtual      equipos_virtuales               @relation(fields: [EquipoVirtualID], references: [EquipoVirtualID], onDelete: NoAction, onUpdate: NoAction, map: "equipos_virtuales_historial_ibfk_1")
  cotizacion         cotizaciones_compra_encabezado? @relation(fields: [CotizacionCompraID], references: [CotizacionCompraID], onDelete: NoAction, onUpdate: NoAction, map: "fk_historial_cotizacion")

  @@index([EquipoVirtualID], map: "idx_historial_equipo")
  @@index([CotizacionCompraID], map: "idx_historial_cotizacion")
}

model cotizaciones_compra_equipos_virtuales {
  ID                    Int                                      @id @default(autoincrement())
  CotizacionCompraID    Int
  EquipoVirtualID       Int
  Cantidad              Int                                      @default(1)
  PrecioOriginal        Decimal                                  @db.Decimal(12, 2)
  PrecioFinal           Decimal                                  @db.Decimal(12, 2)
  FechaCreacion         DateTime?                                @default(now()) @db.DateTime(0)
  cotizacion            cotizaciones_compra_encabezado           @relation(fields: [CotizacionCompraID], references: [CotizacionCompraID], onDelete: NoAction, onUpdate: NoAction, map: "cotizaciones_compra_equipos_virtuales_ibfk_1")
  equipoVirtual         equipos_virtuales                        @relation(fields: [EquipoVirtualID], references: [EquipoVirtualID], onDelete: NoAction, onUpdate: NoAction, map: "cotizaciones_compra_equipos_virtuales_ibfk_2")
  respuestasProveedores cotizaciones_compra_respuestas_equipos[]

  @@unique([CotizacionCompraID, EquipoVirtualID], map: "uk_cotizacion_equipo")
  @@index([CotizacionCompraID], map: "idx_cotizacion")
  @@index([EquipoVirtualID], map: "idx_equipo")
}

