enum TipoServicio {
  INSTALACION
  MANTENIMIENTO
  REPARACION
  DESINSTALACION
}

enum EstatusServicio {
  POR_CONFIRMAR
  PENDIENTE
  CONFIRMADO
  EN_PROCESO
  REALIZADO
  CANCELADO
}

enum OrigenInventarioServicio {
  TECNICO
  BODEGA
}

enum AccionDesinstalacion {
  PIEZAS_INDIVIDUALES
  EQUIPO_COMPLETO
